# These variables must be exported into the process environment; no dotenv loader is bundled.
SV_ENV=local
SV_AUTH_MODE=development
# SV_DATA_DIR=/absolute/private/data
# SV_KEY_DIR=/separate/private/keys
# Legacy pinned-key verifier, without browser federation or approved MFA mapping:
# SV_AUTH_MODE=oidc-rs256
# SV_OIDC_ISSUER=https://your-independent-identity-provider.example
# SV_OIDC_AUDIENCE=subsidiaryvault-local
# SV_OIDC_PUBLIC_KEY=/absolute/path/to/pinned-public-key.pem

# Self-hosted managed reference adapters. See docs/operations/self-hosted-reference.md.
# Use separate migrator/provisioner/runtime/worker identities. No seed outside synthetic fixtures.
# SV_ENV=staging
# SV_DATABASE_DSN=pgsql:host=db.example;dbname=svkms;sslmode=verify-full;sslrootcert=/run/trust/postgres-ca.crt
# SV_DATABASE_USER=svkms_app
# SV_DATABASE_PASSWORD_FILE=/run/secrets/database-password
# SV_AUTH_MODE=oidc-introspection
# SV_OIDC_ISSUER=https://identity.example/realms/vault
# SV_OIDC_AUDIENCE=svkms-api
# SV_OIDC_WEB_CLIENT_ID=svkms-web
# SV_OIDC_INTROSPECTION_CLIENT_ID=svkms-api
# SV_OIDC_INTROSPECTION_CLIENT_SECRET_FILE=/run/secrets/identity-client-secret
# SV_OIDC_MFA_ACR=<exact approved ACR value; omit to deny privileged operations>
# SV_OIDC_MFA_MAX_AGE=300
# SV_KEY_PROVIDER=openbao-transit
# SV_KEY_SERVICE_URL=https://keys.example
# SV_KEY_SERVICE_TOKEN_FILE=/run/secrets/key-service-token
# SV_OBJECT_PROVIDER=s3
# SV_S3_ENDPOINT=https://objects.example
# SV_S3_REGION=us-east-1
# SV_S3_BUCKET=private-vault
# SV_S3_ACCESS_KEY_FILE=/run/secrets/object-access-key
# SV_S3_SECRET_KEY_FILE=/run/secrets/object-secret-key
# SV_UPLOAD_PROFILE=scanned
# SV_CLAMD_ADDRESS=unix:///run/clamav/clamd.sock
# SV_SCAN_MAX_DATABASE_AGE_SECONDS=259200
# SV_ALLOW_INSECURE_TEST_ENDPOINTS is deliberately absent: never set on staging.
